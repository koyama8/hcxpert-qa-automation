    "_postman_id": "88f80995-d60b-4fcb-9ef7-41308ae4e8d8",
    "name": "HCXpert - Testes de API",
    "description": "Coleção para exploração e validação manual das APIs do desafio técnico HCXpert.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Trello",
      "item": [
        {
          "name": "Consultar ação existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status deve ser 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta deve possuir o nome da lista', () => {",
                  "  const body = pm.response.json();",
                  "",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.have.property('list');",
                  "  pm.expect(body.data.list).to.have.property('name');",
                  "  pm.expect(body.data.list.name).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "console.log('Nome da lista:', pm.response.json().data.list.name);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.trello.com/1/actions/592f11060f95a3d3d46a987a",
              "protocol": "https",
              "host": [
                "api",
                "trello",
                "com"
              ],
              "path": [
                "1",
                "actions",
                "592f11060f95a3d3d46a987a"
              ]
            },
            "description": "Consulta uma ação pública do Trello e valida o status e o campo data.list.name."
          },
          "response": []
        }
      ]
    }
  ]
