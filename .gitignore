security/*.json
security/*.xml

# Logs e arquivos temporarios
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.temp

# Cache de ferramentas
.cache/
.nyc_output/
.eslintcache

# Editores e IDEs
.vscode/
.idea/
*.code-workspace

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
Desktop.ini
