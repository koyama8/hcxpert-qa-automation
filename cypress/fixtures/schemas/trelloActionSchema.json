{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "idMemberCreator", "type", "date", "data"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "idMemberCreator": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "data": {
      "type": "object",
      "required": ["list", "board", "card"],
      "properties": {
        "list": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "board": {
          "type": "object",
          "required": ["id", "name", "shortLink"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "shortLink": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "card": {
          "type": "object",
          "required": ["id", "name", "shortLink"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{24}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "shortLink": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
